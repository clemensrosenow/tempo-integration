# Tempo configuration. Copy to `.env` (repo root) and fill in what you need.
# Variables already set in your shell take precedence over this file.

# --- Google OAuth (Desktop app client from Google Cloud Console) -------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LLM ---------------------------------------------------------------------
# Provider: anthropic | gemini | heuristic. If unset, Tempo picks anthropic when
# an Anthropic key is set, else gemini when a Gemini key is set, else the
# offline heuristic (deterministic estimates, greedy placement, template reasons).
TEMPO_LLM=
# Optional model override. Defaults: claude-sonnet-5-5 (anthropic), gemini-3.8-flash (gemini).
TEMPO_LLM_MODEL=
# Anthropic key used by Tempo. ANTHROPIC_API_KEY is accepted as a fallback.
# ANTHROPIC_AUTH_TOKEN and ANTHROPIC_BASE_URL are deliberately IGNORED.
TEMPO_ANTHROPIC_API_KEY=
# Optional Anthropic API base URL (default https://api.anthropic.com).
TEMPO_ANTHROPIC_BASE_URL=
# Gemini key (GOOGLE_API_KEY is accepted as a fallback).
GEMINI_API_KEY=

# --- Runtime -----------------------------------------------------------------
# Where state, tokens and preferences live (default: <repo>/.tempo).
TEMPO_DATA_DIR=
# Planning horizon in days (default 14).
TEMPO_HORIZON_DAYS=14
# Google Tasks / calendar polling interval in seconds (default 60).
TEMPO_POLL_INTERVAL_SEC=60
# Debounce window for bursts of changes in milliseconds (default 90000).
TEMPO_DEBOUNCE_MS=90000

# --- Optional push notifications (Calendar webhooks) ---------------------------
# Public HTTPS URL that forwards to the local webhook port (e.g. a tunnel).
# Leave empty to rely on polling only.
TEMPO_WEBHOOK_URL=
TEMPO_WEBHOOK_PORT=8787
