{
  "name": "tempo-integration",
  "version": "0.1.0",
  "private": true,
  "description": "Tempo: AI time-blocking that lives inside Google Calendar (headless integration, no UI).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tempo": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tempo": "tsx src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.3.0",
    "dotenv": "^18.0.10",
    "google-auth-library": "^11.3.4",
    "googleapis": "^190.0.0",
    "luxon": "^3.7.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
